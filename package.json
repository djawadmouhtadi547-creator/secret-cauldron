
{
  "name": "prime-launcher",
  "version": "0.4.0-beta.1",
  "description": "Prime Launcher — Arabic-first Minecraft Java launcher by Gmu Studios",
  "author": "Gmu Studios",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/copy-vendor-assets.js",
    "build": "electron-builder --win nsis --x64 --publish never",
    "build:linux": "electron-builder --linux AppImage --x64 --publish never",
    "pack": "electron-builder --dir",
    "check": "node scripts/check-project.js",
    "test": "node --test tests/*.test.js",
    "copy:vendor": "node scripts/copy-vendor-assets.js",
    "prebuild": "npm run copy:vendor",
    "prebuild:linux": "npm run copy:vendor",
    "check:syntax": "node scripts/check-syntax.js",
    "check:secrets": "node scripts/check-secrets.js",
    "validate": "npm run check && npm run check:syntax && npm run check:secrets && npm test"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "extract-zip": "2.0.1",
    "tar": "7.5.22",
    "skinview3d": "3.4.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "studio.gmu.primelauncher",
    "productName": "Prime Launcher",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "keys.json",
      "package.json",
      "README.md",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/logo/prime.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  }
}
